MODEL_PROVIDER=QWEN
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=
USE_LLM=true
MAX_ROUNDS=10
# Client-side context budget; input budget = window minus output reserve.
CONTEXT_WINDOW_TOKENS=32768
CONTEXT_OUTPUT_RESERVE_TOKENS=4096
# Local or remote OpenAI-compatible embeddings endpoint.
EMBEDDING_BASE_URL=
# Leave base URL empty to reuse local Python inference.
# EMBEDDING_MODEL_PATH=/absolute/path/to/qwen3-embedding-0.6b
PYTHON=python3
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
